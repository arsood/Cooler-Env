{
  "name": "cooler-env",
  "version": "2.1.0",
  "description": "CLI + module utility to help you manage your environment variables better. Inspired by Ruby on Rails credentials.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Arun Sood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arsood/Cooler-Env.git"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cryptify": "^4.1.2",
    "figlet": "^1.7.0",
    "inquirer": "^11.1.0",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^29.5.13",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3"
  },
  "packageManager": "yarn@4.2.2"
}
